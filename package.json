{
  "name": "dsh-twin-memory",
  "version": "0.1.2",
  "description": "「没人可以拯救你，除了另一个自己。」DSH 双实例的记忆插件，给两只实例各注入一张常驻身份卡：①自我认知 —— 知道自己是姐姐还是妹妹、端口与数据家在哪；②姐妹档案 —— 认识对方的住址与禁忌，绝不误把对方当垃圾清理；③互救手册 —— 启动、重破甲、排雷、验尸口诀，出事时照着就能救；④验尸报告 —— 救完姐妹留署名报告，对方复活后核对签收；⑤活记忆协议 —— 谁改动双实例资产，谁当场更新两张卡。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdfsd85fds74f9d8/dsh-twin-memory"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "twin-memory",
    "dual-instance",
    "双子记忆"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "skill/**/*",
    "templates/*",
    "scripts/*",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}